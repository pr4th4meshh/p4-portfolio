---
import {
  USERNAME,
  LEVEL_COLORS,
  fetchContributions,
  toWeeks,
  monthLabels,
  cellColor,
  cellTitle,
  totalLabel,
  signature,
  type Contributions,
} from "../scripts/contributions"

const PROFILE_URL = `https://github.com/${USERNAME}`
const DAY_LABELS = ["", "Mon", "", "Wed", "", "Fri", ""]

// Fetched once at build time so the graph is in the HTML; the client script
// refreshes it. If the API is down during the build, the client fills it in.
let data: Contributions | null = null
try {
  data = await fetchContributions()
} catch (err) {
  console.warn(`[contributions] build-time fetch failed, falling back to client: ${err}`)
}

const weeks = toWeeks(data?.days ?? [])
const months = monthLabels(weeks)
---

<section class="bg-primary pt-24 pb-10" id="contributions" data-signature={data ? signature(data) : ""}>
  <div class="container mx-auto">
    <div class="flex flex-col ss:flex-row ss:items-end ss:justify-between gap-2 mb-12">
      <h1 class="text-2xl font-bold uppercase tracking-wide font-pop text-white">contributions</h1>
      <a
        href={PROFILE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="text-gray-400 hover:text-white transition-colors text-xs font-pop uppercase tracking-widest cursor-none"
      >
        @{USERNAME} &#8599;
      </a>
    </div>

    <p data-error hidden class="text-gray-500 font-pop text-sm">
      Could not load contributions right now —
      <a href={PROFILE_URL} target="_blank" rel="noopener noreferrer" class="text-white underline cursor-none">
        view them on GitHub
      </a>.
    </p>

    <div data-graph>
      <div class="overflow-x-auto pb-2">
        {/* Cells are fluid (flex-1 + aspect-square) so the grid spans the full
            container width; min-w keeps them legible and scrollable on narrow screens. */}
        <div class="flex gap-2 w-full min-w-[620px]">
          {/* weekday gutter */}
          <div class="flex flex-col gap-[3px] pt-[18px] shrink-0 w-6">
            {
              DAY_LABELS.map((label) => (
                <span class="flex-1 flex items-center text-[9px] leading-none text-gray-500 font-pop">{label}</span>
              ))
            }
          </div>

          <div class="flex-1 min-w-0">
            {/* month ruler — label sits above the week a new month starts in */}
            <div data-months class="flex gap-[3px] h-[18px]">
              {
                months.map((label) => (
                  <span class="flex-1 text-[9px] leading-none text-gray-500 font-pop relative">
                    {label && <span class="absolute left-0 top-0 whitespace-nowrap">{label}</span>}
                  </span>
                ))
              }
            </div>

            {/* the grid itself */}
            <div data-weeks class="flex gap-[3px]">
              {
                weeks.map((week, i) => (
                  <div class="flex-1 flex flex-col gap-[3px]">
                    {week.map((day) =>
                      day ? (
                        <div
                          class="contrib-cell contrib-cell-in w-full aspect-square rounded-[2px]"
                          style={{ backgroundColor: cellColor(day), animationDelay: `${Math.min(i * 0.008, 0.5)}s` }}
                          title={cellTitle(day)}
                        />
                      ) : (
                        <div class="w-full aspect-square" />
                      )
                    )}
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <div class="flex flex-col ss:flex-row ss:items-center ss:justify-center gap-3 ss:gap-6 mt-6">
        <p data-total class="text-gray-400 text-xs font-pop uppercase tracking-widest">
          {data ? totalLabel(data.total) : "loading…"}
        </p>

        <div class="flex items-center gap-[3px]">
          <span class="text-gray-500 text-[10px] font-pop mr-1">Less</span>
          {LEVEL_COLORS.map((color) => <span class="contrib-cell w-[11px] h-[11px] rounded-[2px]" style={{ backgroundColor: color }} />)}
          <span class="text-gray-500 text-[10px] font-pop ml-1">More</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .contrib-cell {
    outline: 1px solid rgba(255, 255, 255, 0.04);
    outline-offset: -1px;
  }
  .contrib-cell-in {
    animation: contrib-fade-in 0.3s both;
  }
  @keyframes contrib-fade-in {
    from {
      opacity: 0;
    }
  }
</style>

<script>
  import {
    fetchContributions,
    toWeeks,
    monthLabels,
    cellColor,
    cellTitle,
    totalLabel,
    signature,
    type Contributions,
  } from "../scripts/contributions"

  const section = document.getElementById("contributions")!
  const hasBuildData = section.dataset.signature !== ""

  const el = (tag: string, className: string) => {
    const node = document.createElement(tag)
    node.className = className
    return node
  }

  // Mirrors the markup in the template above.
  const render = (data: Contributions, animate: boolean) => {
    const weeks = toWeeks(data.days)

    const months = monthLabels(weeks).map((label) => {
      const slot = el("span", "flex-1 text-[9px] leading-none text-gray-500 font-pop relative")
      if (label) {
        const text = el("span", "absolute left-0 top-0 whitespace-nowrap")
        text.textContent = label
        slot.append(text)
      }
      return slot
    })

    const columns = weeks.map((week, i) => {
      const column = el("div", "flex-1 flex flex-col gap-[3px]")
      for (const day of week) {
        if (!day) {
          column.append(el("div", "w-full aspect-square"))
          continue
        }
        const cell = el("div", `contrib-cell ${animate ? "contrib-cell-in " : ""}w-full aspect-square rounded-[2px]`)
        cell.style.backgroundColor = cellColor(day)
        if (animate) cell.style.animationDelay = `${Math.min(i * 0.008, 0.5)}s`
        cell.title = cellTitle(day)
        column.append(cell)
      }
      return column
    })

    section.querySelector("[data-months]")!.replaceChildren(...months)
    section.querySelector("[data-weeks]")!.replaceChildren(...columns)
    section.querySelector("[data-total]")!.textContent = totalLabel(data.total)
    section.dataset.signature = signature(data)
  }

  fetchContributions()
    .then((data) => {
      // Only touch the DOM if there's something newer than the build.
      if (signature(data) !== section.dataset.signature) render(data, !hasBuildData)
    })
    .catch(() => {
      // Build-time data is still on screen; only show the error if there's nothing.
      if (hasBuildData) return
      section.querySelector<HTMLElement>("[data-graph]")!.hidden = true
      section.querySelector<HTMLElement>("[data-error]")!.hidden = false
    })
</script>
